              <Suspense fallback={<PageLoader />}>
                <FacultyAttendanceMarking 
                  collegeId={user?.collegeId || ''} 
                  facultyId={user?.id || ''} 
                  facultyName={user?.name || 'Faculty'} 
                />
              </Suspense>
            </RoleRoute>
          } />

          {/* ═══════════════════════════════════════════════════════════════
              NEW: Faculty Curriculum Route
          ═══════════════════════════════════════════════════════════════ */}
          <Route path="/faculty/curriculum" element={
            <RoleRoute allowedRoles={['faculty', 'admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><FacultyCurriculum /></Suspense>
            </RoleRoute>
          } />

          {/* ═══════════════════════════════════════════════════════════════ */}
          {/* NEW: AI Question Generator Route                             */}
          {/* ═══════════════════════════════════════════════════════════════ */}
          <Route path="/faculty/ai-questions" element={
            <RoleRoute allowedRoles={['faculty', 'admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><AIQuestionGenerator /></Suspense>
            </RoleRoute>
          } />

          <Route path="/unauthorized" element={<Unauthorized />} />
        </Route>
      )}

      {/* ═══════════════════════════════════════════════════════════════ */}
      {/* FALLBACK REDIRECTS                                             */}
      {/* ═══════════════════════════════════════════════════════════════ */}
      <Route path="*" element={
        isStudentLoggedIn ? <Navigate to="/student" replace /> :
        user ? <Navigate to="/" replace /> :
        <Navigate to="/" replace />
      } />
    </Routes>
  )
}

export default App