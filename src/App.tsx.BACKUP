            <RoleRoute allowedRoles={['hod']}>
              <Suspense fallback={<PageLoader />}><HODDashboard /></Suspense>
            </RoleRoute>
          } />

          {/* ═══════════════════════════════════════════════════════════════ */}
          {/* Super Admin Routes                                           */}
          {/* ═══════════════════════════════════════════════════════════════ */}
          <Route path="/superadmin" element={
            <RoleRoute allowedRoles={['superadmin']}>
              <Suspense fallback={<PageLoader />}><SuperAdminDashboard /></Suspense>
            </RoleRoute>
          } />
