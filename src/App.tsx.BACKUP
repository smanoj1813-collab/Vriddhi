// ── Loading fallback ──────────────────────────────────────────────────
const PageLoader = () => (
  <div className="min-h-screen bg-slate-900 flex items-center justify-center">
    <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-400" />
  </div>
)

// ── Role-based route guard ────────────────────────────────────────────
function RoleRoute({ children, allowedRoles }: { children: React.ReactNode; allowedRoles: string[] }) {
  const { user } = useAuth()
  if (!user) return <Navigate to="/" replace />
  if (!allowedRoles.includes(user.role)) return <Navigate to="/unauthorized" replace />
  return <>{children}</>
}

// ── Student route guard ───────────────────────────────────────────────
function StudentRoute({ children }: { children: React.ReactNode }) {
  const studentToken = localStorage.getItem('studentToken')
  const studentRole = localStorage.getItem('studentRole')
  if (!studentToken || studentRole !== 'student') return <Navigate to="/student/login" replace />
  return <>{children}</>
}

// ── Student Layout wrapper ────────────────────────────────────────────
function StudentLayout() {
  const studentToken = localStorage.getItem('studentToken')
  const studentRole = localStorage.getItem('studentRole')
  if (!studentToken || studentRole !== 'student') return <Navigate to="/student/login" replace />

  return (
    <div className="flex min-h-screen bg-slate-950">
      <Suspense fallback={<div className="w-72 bg-slate-900" />}>
        <StudentSidebar />
      </Suspense>
      <main className="flex-1 overflow-auto pb-20 md:pb-0">
        <Routes>
          <Route path="/" element={<StudentDashboard />} />
          <Route path="/schedule" element={
            <Suspense fallback={<PageLoader />}>
              <SchedulingPage studentId={studentToken} />
            </Suspense>
          } />
          {/* ═══════════════════════════════════════════════════════════════
              NEW: Student Assessment Portal Routes
          ═══════════════════════════════════════════════════════════════ */}
          <Route path="/assessments" element={
            <Suspense fallback={<PageLoader />}>
              <StudentTestDashboard />
            </Suspense>
          } />
          <Route path="/test/:testId/instructions" element={
            <Suspense fallback={<PageLoader />}>
              <TestInstructionsPage />
            </Suspense>
          } />
          <Route path="/test/:testId/take" element={
            <Suspense fallback={<PageLoader />}>
              <ActiveTestPage />
            </Suspense>
          } />
          <Route path="/test/:testId/result" element={
            <Suspense fallback={<PageLoader />}>
              <TestResultPage />
            </Suspense>
          } />
          {/* Legacy route — redirect to new portal */}
          <Route path="/upcoming-assessments" element={
            <Suspense fallback={<PageLoader />}>
              <UpcomingAssessments assessments={[]} />
            </Suspense>
          } />
          <Route path="/assignments" element={
            <Suspense fallback={<PageLoader />}>
              <PendingAssignments
                assignments={[]}
                onSubmit={(assignmentId: string) => {
                  console.log('Submit assignment', assignmentId)
                }}
              />
            </Suspense>
          } />
          <Route path="/attendance" element={
            <Suspense fallback={<PageLoader />}>
              <AttendancePage studentId={studentToken} />
            </Suspense>
          } />
          {/* NEW: Grades & Progress page */}
          <Route path="/grades" element={
            <Suspense fallback={<PageLoader />}>
              <StudentGrades />
            </Suspense>
          } />
          <Route path="/fees" element={
            <Suspense fallback={<PageLoader />}>
              <FeeManagementPage studentId={studentToken} />
            </Suspense>
          } />
          {/* NEW: Study Materials page */}
          <Route path="/materials" element={
            <Suspense fallback={<PageLoader />}>
              <StudentMaterials />
            </Suspense>
          } />
          {/* NEW: Time Table page */}
          <Route path="/timetable" element={
            <Suspense fallback={<PageLoader />}>
              <StudentTimetable />
            </Suspense>
          } />
          {/* NEW: Library page */}
          <Route path="/library" element={
            <Suspense fallback={<PageLoader />}>
              <StudentLibrary />
            </Suspense>
          } />
          {/* NEW: Events page */}
          <Route path="/events" element={
            <Suspense fallback={<PageLoader />}>
              <StudentEvents />
            </Suspense>
          } />
          {/* FIXED: Only one notifications route using the full page */}
          <Route path="/notifications" element={
            <Suspense fallback={<PageLoader />}>
              <StudentNotificationsPage />
            </Suspense>
          } />
          {/* Settings page */}
          <Route path="/settings" element={
            <Suspense fallback={<PageLoader />}>
              <StudentSettings />
            </Suspense>
          } />
        </Routes>
      </main>
    </div>
  )
}

// ── Main App ────────────────────────────────────────────────────────
function App() {
  const { user, isLoading } = useAuth()

  if (isLoading) {
    return (
      <div className="min-h-screen bg-slate-900 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-400" />
      </div>
    )
  }

  const studentToken = localStorage.getItem('studentToken')
  const isStudentLoggedIn = studentToken && localStorage.getItem('studentRole') === 'student'

  const isFaculty = user?.role === 'faculty'
  const isAdmin = user?.role === 'admin'
  const isHOD = user?.role === 'hod'
  const isMentor = user?.role === 'mentor'
  const isSuperAdmin = user?.role === 'superadmin'

  // NOT logged in at all → show login pages
  if (!user && !isStudentLoggedIn) {
    return (
      <Routes>
        <Route path="/student/login" element={<StudentLogin />} />
        <Route path="/*" element={<Login />} />
      </Routes>
    )
  }

  return (
    <Routes>
      {/* ═══════════════════════════════════════════════════════════════ */}
      {/* STUDENT ROUTES — accessible if student is logged in            */}
      {/* ═══════════════════════════════════════════════════════════════ */}
      <Route path="/student/login" element={
        isStudentLoggedIn ? <Navigate to="/student" replace /> : <StudentLogin />
      } />
      <Route path="/student/*" element={
        isStudentLoggedIn ? <StudentLayout /> : <Navigate to="/student/login" replace />
      } />

      {/* ═══════════════════════════════════════════════════════════════ */}
      {/* MAIN APP ROUTES — only if auth user exists                     */}
      {/* ═══════════════════════════════════════════════════════════════ */}
      {user && (
        <Route element={<Layout />}>
          {/* Root redirect based on role */}
          <Route path="/" element={
            isFaculty ? <Navigate to="/faculty" replace /> :
            isHOD ? <Navigate to="/hod" replace /> :
            isAdmin ? <Navigate to="/admin" replace /> :
            isSuperAdmin ? <Navigate to="/superadmin" replace /> :
            <Dashboard />
          } />

          {/* ═══════════════════════════════════════════════════════════════ */}
          {/* PRINCIPAL (admin) Routes — FULL COLLEGE ACCESS               */}
          {/* ═══════════════════════════════════════════════════════════════ */}
          <Route path="/admin" element={
            <RoleRoute allowedRoles={['admin']}>
              <Suspense fallback={<PageLoader />}><AdminDashboard /></Suspense>
            </RoleRoute>
          } />
          <Route path="/students" element={
            <RoleRoute allowedRoles={['admin', 'hod', 'mentor']}>
              <Suspense fallback={<PageLoader />}><Students /></Suspense>
            </RoleRoute>
          } />
          <Route path="/360-view" element={
            <RoleRoute allowedRoles={['admin', 'hod', 'mentor', 'faculty']}>
              <Suspense fallback={<PageLoader />}><View360 /></Suspense>
            </RoleRoute>
          } />
          <Route path="/attendance" element={
            <RoleRoute allowedRoles={['admin', 'hod', 'mentor']}>
              <Suspense fallback={<PageLoader />}><Attendance /></Suspense>
            </RoleRoute>
          } />
          <Route path="/assessments" element={
            <RoleRoute allowedRoles={['admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><Assessments /></Suspense>
            </RoleRoute>
          } />
          <Route path="/class-schedule" element={
            <RoleRoute allowedRoles={['admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><AdminClassSchedule /></Suspense>
            </RoleRoute>
          } />
          <Route path="/fees" element={
            <RoleRoute allowedRoles={['admin']}>
              <Suspense fallback={<PageLoader />}><AdminFeeManagement /></Suspense>
            </RoleRoute>
          } />
          <Route path="/question-bank" element={
            <RoleRoute allowedRoles={['admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><QuestionBank /></Suspense>
            </RoleRoute>
          } />
          <Route path="/question-bank/admin" element={
            <RoleRoute allowedRoles={['admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><QuestionBankAdmin /></Suspense>
            </RoleRoute>
          } />
          <Route path="/paper-generator" element={
            <RoleRoute allowedRoles={['admin', 'hod']}>
              <Suspense fallback={<PageLoader />}><PaperGeneratorAdmin /></Suspense>
            </RoleRoute>
          } />
          <Route path="/analytics" element={
            <RoleRoute allowedRoles={['admin', 'hod', 'mentor']}>
              <Suspense fallback={<PageLoader />}><Analytics /></Suspense>
            </RoleRoute>
          } />
          <Route path="/journey" element={
            <RoleRoute allowedRoles={['admin', 'hod', 'mentor', 'faculty']}>
              <Suspense fallback={<PageLoader />}><Journey /></Suspense>
            </RoleRoute>
          } />
          <Route path="/settings" element={
            <RoleRoute allowedRoles={['admin']}>
              <Suspense fallback={<PageLoader />}><Settings /></Suspense>
            </RoleRoute>
          } />

          {/* ═══════════════════════════════════════════════════════════════
              NEW: Admin Curriculum Mapping & Scheduling Route
          ═══════════════════════════════════════════════════════════════ */}
