# ─────────────────────────────────────────────────────────────────────────────
# Vriddhi — frontend environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (git-ignored) and fill in the values:
#
#     cp .env.example .env
#
# Every variable Vite exposes to the browser MUST be prefixed with `VITE_`.
# Without the prefix the value is silently undefined at runtime.
#
# All ten values below are consumed by the app:
#   * VITE_FIREBASE_*  -> src/Firebase/config.ts
#   * VITE_API_*       -> src/modules/admin/api/aiQuestionApi.ts,
#                         src/shared/utils/pdfDownloader.ts
#
# ⚠️  These are *public client-side* keys, not secrets. Anyone who loads the
#     deployed site can read them. Protect your data with Firestore /
#     Realtime Database security rules, not by hiding these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web app config ─────────────────────────────────────────────────
# Where to find these:
#   Firebase console → your project → ⚙ Project settings → "Your apps"
#   → SDK setup and configuration → "Config"
# It is the object passed to initializeApp(), keys renamed with VITE_ prefixes.

# Required. Identifies the API key for the web app.
VITE_FIREBASE_API_KEY=AIzaSy...your-api-key

# Required. Auth domain, normally <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=vriddhi-academic.firebaseapp.com

# Required. Realtime Database URL, normally
# https://<project-id>-default-rtdb.asia-south1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=https://vriddhi-academic-default-rtdb.asia-south1.firebasedatabase.app

# Required. The Firebase project ID.
VITE_FIREBASE_PROJECT_ID=vriddhi-academic

# Required. Cloud Storage bucket, normally <project-id>.appspot.com
VITE_FIREBASE_STORAGE_BUCKET=vriddhi-academic.appspot.com

# Required. The numeric sender ID from the app config.
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Required. The app ID from the app config (format 1:<sender-id>:web:<hash>).
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789

# Optional in Firebase itself, but read unconditionally by src/Firebase/config.ts.
# Leave blank only if Analytics is disabled for the project.
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Cloud Functions API base URL ────────────────────────────────────────────
# VITE_API_BASE_URL is the preferred name; VITE_API_URL is accepted as a
# fallback. If neither is set, the code falls back to the production
# Functions URL hardcoded in src/modules/admin/api/aiQuestionApi.ts.
# Only one of the two is needed — set VITE_API_BASE_URL.

# Cloud Functions (regional endpoint, /api suffix included)
VITE_API_BASE_URL=https://asia-south1-vriddhi-academic.cloudfunctions.net/api

# Legacy alias. Safe to leave empty if VITE_API_BASE_URL is set.
VITE_API_URL=
