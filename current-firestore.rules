rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function claimRole() {
      return request.auth.token.role;
    }

    function claimCollege() {
      return request.auth.token.collegeId;
    }

    function role() {
      return claimRole() != null ? claimRole() : userDoc().role;
    }

    function collegeId() {
      return claimCollege() != null ? claimCollege() : userDoc().collegeId;
    }

    function isSuperadmin() {
      return isSignedIn() && role() == 'superadmin';
    }

    function isStaff() {
      return isSignedIn() && role() in ['superadmin', 'admin', 'principal', 'hod', 'faculty', 'mentor'];
    }

    function isCollegeStaff() {
      return isStaff() && (isSuperadmin() || collegeId() != null);
    }

    function sameCollege(data) {
      return isSuperadmin() || (collegeId() != null && data.collegeId == collegeId());
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Student records use generated domain document IDs. Provisioning links
    // each record to Firebase Auth through `userId`; `uid` and a UID document
    // ID are accepted only for legacy records.
    function ownsStudentProfile(studentId, studentData) {
      return isSignedIn()
        && (
          studentData.userId == request.auth.uid
          || studentData.uid == request.auth.uid
          || studentId == request.auth.uid
        );
    }

    function ownsStudentId(studentId) {
      return isSignedIn()
        && studentId != null
        && (
          studentId == request.auth.uid
          || get(/databases/$(database)/documents/students/$(studentId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid
        );
    }

    function immutableUserFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.collegeId == resource.data.collegeId;
    }

    function noPasswordField() {
      return !('password' in request.resource.data);
    }

    // ══════════════════════════════════════════════════════════════
    // USERS — client cannot create; must go through CF
    // ══════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId)
        || isSuperadmin()
        || (isStaff() && sameCollege(resource.data));
      allow create: if false;  // Cloud Function only
      allow update: if isOwner(userId)
        && immutableUserFields()
        && noPasswordField()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'collegeId', 'uid', 'permissions', 'createdBy']);
      allow delete: if isSuperadmin();
    }

    match /students/{id} {
      allow read: if ownsStudentProfile(id, resource.data)
        || isSuperadmin()
        || (isStaff() && sameCollege(resource.data));
      allow create: if isSuperadmin()
        || (role() in ['admin', 'hod'] && sameCollege(request.resource.data));
      allow update: if isSuperadmin()
        || (role() in ['admin', 'hod']
          && sameCollege(resource.data)
          && request.resource.data.collegeId == resource.data.collegeId
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isSuperadmin()
        || (role() in ['admin', 'hod'] && sameCollege(resource.data));
    }

    match /faculty/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data) || resource.data.uid == request.auth.uid);
      allow write: if isSuperadmin() || (role() in ['admin', 'hod'] && sameCollege(request.resource.data));
    }

    match /admins/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data) || resource.data.uid == request.auth.uid);
      allow write: if isSuperadmin();
    }

    match /hods/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data) || resource.data.uid == request.auth.uid);
      allow write: if isSuperadmin() || (role() == 'admin' && sameCollege(request.resource.data));
    }

    match /mentors/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data) || resource.data.uid == request.auth.uid);
      allow write: if isSuperadmin() || (role() in ['admin', 'hod'] && sameCollege(request.resource.data));
    }

    match /superadmins/{id} {
      allow read: if isSuperadmin();
      allow write: if isSuperadmin();
    }

    match /colleges/{collegeId} {
      allow read: if isSignedIn() && (isSuperadmin() || collegeId() == collegeId);
      allow write: if isSuperadmin();

      match /students/{id} {
        allow read: if ownsStudentProfile(id, resource.data)
          || isSuperadmin()
          || (isStaff() && collegeId() == collegeId);
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }
    }

    match /questions/{id} {
      // Question-authoring documents contain answer keys and explanations.
      // Student delivery uses server-filtered assessment payloads, never this
      // collection directly.
      allow read: if isSignedIn() && (
        isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
      );
      allow create: if isCollegeStaff() && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollegeStaff() && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if isSuperadmin() || (role() == 'admin' && sameCollege(resource.data));
    }

    match /papers/{id} {
      // Papers snapshot correct answers and are authoring-only documents.
      allow read: if isSignedIn() && (
        isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
      );
      // Legacy authoring may create/edit content-only drafts. Every submission,
      // approval and publication transition is callable-owned and audited.
      allow create: if isCollegeStaff()
        && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.verificationStatus == 'draft';
      allow update: if isCollegeStaff()
        && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId
        && resource.data.status == 'draft'
        && resource.data.verificationStatus in ['draft', 'modification-requested', 'rejected-by-hod']
        && (resource.data.createdBy == request.auth.uid
          || role() in ['superadmin', 'admin', 'principal', 'hod'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'collegeId', 'createdBy', 'createdByName', 'status',
          'verificationStatus', 'submittedAt', 'publishedAt',
          'reviewedBy', 'reviewedByName', 'reviewedAt', 'approvalRemarks'
        ]);
      allow delete: if resource.data.status == 'draft'
        && (isSuperadmin() || (role() == 'admin' && sameCollege(resource.data)));
    }

    match /paperReviewAudit/{auditId} {
      allow read: if isSuperadmin()
        || (role() in ['admin', 'principal', 'hod'] && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    match /attendance/{id} {
      allow read: if ownsStudentId(resource.data.studentId)
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || isSuperadmin()
        || (isStaff() && sameCollege(resource.data));
      allow write: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    match /attendanceRecords/{id} {
      allow read: if ownsStudentId(resource.data.studentId)
        || isSuperadmin()
        || (isStaff() && sameCollege(resource.data));
      allow write: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.studentId == request.auth.uid || (role() in ['admin', 'hod'] && sameCollege(resource.data)));
      allow write: if isSuperadmin() || (role() == 'admin' && sameCollege(request.resource.data));
    }

    match /feeStructures/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data));
      allow write: if isSuperadmin() || (role() == 'admin' && sameCollege(request.resource.data));
    }

    // ══════════════════════════════════════════════════════════════
    // WEEKLY SCHEDULES — weekly recurring timetable
    // ══════════════════════════════════════════════════════════════
    match /weeklySchedules/{scheduleId} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data));
      allow create: if isCollegeStaff() && request.resource.data.collegeId == collegeId()
        && request.resource.data.facultyId != null
        && request.resource.data.branch != null
        && request.resource.data.batch != null
        && request.resource.data.dayOfWeek != null
        && request.resource.data.startTime != null
        && request.resource.data.endTime != null;
      allow update: if isCollegeStaff() && sameCollege(resource.data);
      allow delete: if isCollegeStaff() && sameCollege(resource.data);
    }

    // ══════════════════════════════════════════════════════════════
    // CLASS SESSIONS — daily session records
    // ══════════════════════════════════════════════════════════════
    match /classSessions/{sessionId} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data));
      allow create, update: if isCollegeStaff() && sameCollege(request.resource.data);
      allow delete: if isCollegeStaff() && sameCollege(resource.data);
    }

    // ══════════════════════════════════════════════════════════════
    // CURRICULUM FACULTY MAPPINGS
    // ══════════════════════════════════════════════════════════════
    match /curriculumFacultyMappings/{mappingId} {
      allow read: if isSignedIn() && (isSuperadmin() || sameCollege(resource.data));
      allow create, update, delete: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    // ══════════════════════════════════════════════════════════════
    // ASSESSMENTS — authoring reads for staff; all attempt transitions,
    // question delivery, submissions and grading are server-owned.
    // ══════════════════════════════════════════════════════════════
    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && (
        isSuperadmin() || (isStaff() && sameCollege(resource.data))
      );
      allow create: if isCollegeStaff() && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollegeStaff() && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if isSuperadmin()
        || (role() == 'admin' && sameCollege(resource.data));
    }

    match /scheduledTests/{testId} {
      allow read: if isSignedIn() && (
        isSuperadmin() || (isStaff() && sameCollege(resource.data))
      );
      allow write: if false;

      match /assessmentQuestions/{questionId} {
        allow read: if isSignedIn() && (
          isSuperadmin()
          || (isStaff()
            && sameCollege(get(/databases/$(database)/documents/scheduledTests/$(testId)).data))
        );
        allow write: if false;
      }
    }

    match /studentAssessments/{attemptId} {
      // Students receive state/result projections from callables so unreleased
      // scores and server grading breakdowns cannot be inspected directly.
      allow read: if isSignedIn() && (
        isSuperadmin() || (isStaff() && sameCollege(resource.data))
      );
      allow write: if false;
    }

    match /studentSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        isSuperadmin() || (isStaff() && sameCollege(resource.data))
      );
      allow write: if false;
    }

    match /proctoringLogs/{logId} {
      allow read: if isSignedIn() && (
        isSuperadmin() || (isStaff() && sameCollege(resource.data))
      );
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // ASSIGNMENTS — faculty create, students read/submit
    // ══════════════════════════════════════════════════════════════
    match /assignments/{assignmentId} {
      // Students receive only server-filtered assignment payloads. Direct
      // documents may include targeting and internal authoring metadata.
      allow read: if isSignedIn() && (
        isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
      );
      // Authoring and lifecycle transitions are validated by callable
      // functions; clients cannot publish, reopen, retarget, or delete records.
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // SUBMISSIONS — students submit, faculty grade
    // ══════════════════════════════════════════════════════════════
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
        || resource.data.studentUid == request.auth.uid
        || ownsStudentId(resource.data.studentId)
      );
      // Submission creation/resubmission is a server transaction that validates
      // assignment targeting, deadlines, upload metadata, and idempotency.
      allow create: if false;
      // Grading also runs through a server transaction that checks assignment
      // ownership and score bounds.
      allow update, delete: if false;
    }

    match /assignmentSubmissionDrafts/{draftId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // OFFICIAL GRADE RECORDS — separate from assessment attempts
    // ══════════════════════════════════════════════════════════════
    match /gradeRecords/{gradeId} {
      // Draft transcript records remain registrar-only until an explicit,
      // server-audited publish transition.
      allow read: if (
          ownsStudentId(resource.data.studentId)
          && resource.data.status == 'published'
        )
        || isSuperadmin()
        || (role() in ['admin', 'principal', 'hod'] && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    match /gradeRecordAudit/{auditId} {
      allow read: if isSuperadmin()
        || (role() in ['admin', 'principal', 'hod'] && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // LOGS & AUDIT
    // ══════════════════════════════════════════════════════════════
    match /logs/{id} {
      allow read: if isSuperadmin() || (role() == 'admin' && sameCollege(resource.data));
      allow create: if isStaff();
      allow update, delete: if isSuperadmin();
    }

    match /ai_generation_logs/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{id} {
      // Personal notifications are authorised by immutable identity only.
      // Students may read records addressed to their own Auth UID or canonical
      // student ID; staff retain same-college access. A shared broadcast must
      // never rely on a college-wide student read (previously `sameCollege`
      // leaked every same-college notification to every student).
      allow read: if isSignedIn() && (
        isSuperadmin()
        || (isStaff() && sameCollege(resource.data))
        || resource.data.userId == request.auth.uid
        || ownsStudentId(resource.data.studentId)
      );
      allow write: if isCollegeStaff();
    }

    // ══════════════════════════════════════════════════════════════
    // CATCH-ALL — deny everything else
    // IMPORTANT: Keep this at the END, after all specific match blocks
    // ══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
