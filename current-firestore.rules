rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function claimRole() {
      return isSignedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function claimCollege() {
      return isSignedIn() && 'collegeId' in request.auth.token
        ? request.auth.token.collegeId
        : null;
    }

    function userDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    // -- Legacy identity resolution -------------------------------------------
    // Accounts created before the Access Control work - imported faculty,
    // hand-written profile documents, spreadsheet uploads - often have no
    // custom claims and no users/{uid} document, and they spell the same role
    // in many ways ("Faculty", "teacher", "Head of Department", ...). Those
    // users used to resolve to a null role, which silently denied every staff
    // read. The helpers below normalise those identities. They mirror the
    // lookup order used by the client in src/modules/auth/context/auth.ts.
    //
    // Compiler note: the rules backend fails deployment with an HTTP 503
    // ("The service is currently unavailable") when expressions exceed its
    // complexity limits - deeply nested ternary chains are the documented
    // trigger. The resolvers below therefore use `in` list membership,
    // map.get(key, default) cascades, and one small helper per cascade step
    // instead of long nested ternaries. `let` bindings are treated as eager,
    // so every conditional get()/exists() stays inside a guarded ternary and
    // short-circuiting &&/||/? : expressions.

    function cleanRoleValue(raw) {
      return raw is string ? raw.trim().lower() : '';
    }

    // Spelling variants of each canonical role. `in` list membership keeps
    // the compiler's expression tree shallow.
    function facultySpelling(value) {
      return value in ['teacher', 'teaching staff', 'teaching-staff',
        'teaching_staff', 'lecturer', 'professor', 'assistant professor',
        'associate professor', 'instructor', 'faculty member',
        'faculty-member'];
    }

    function hodSpelling(value) {
      return value in ['head of department', 'head-of-department',
        'head_of_department', 'dept head', 'department head'];
    }

    function adminSpelling(value) {
      return value in ['administrator', 'admin staff', 'college admin'];
    }

    function superadminSpelling(value) {
      return value in ['super admin', 'super-admin', 'super_admin',
        'superuser', 'owner'];
    }

    function principalSpelling(value) {
      return value in ['vice principal', 'vice-principal', 'vice_principal'];
    }

    function studentSpelling(value) {
      return value in ['learner', 'pupil'];
    }

    function canonicalStaffRole(value) {
      return facultySpelling(value) ? 'faculty'
        : hodSpelling(value) ? 'hod'
        : adminSpelling(value) ? 'admin'
        : superadminSpelling(value) ? 'superadmin'
        : '';
    }

    function canonicalRole(value) {
      let staffRole = canonicalStaffRole(value);
      return staffRole != '' ? staffRole
        : principalSpelling(value) ? 'principal'
        : studentSpelling(value) ? 'student'
        : value == 'guardian' ? 'parent'
        : value;
    }

    // Legacy documents store the role under role, userRole, or userType.
    function roleField(data) {
      return cleanRoleValue(data.get('role', data.get('userRole', data.get('userType', ''))));
    }

    // fall backRole is used when the profile document exists but carries no
    // role field - membership of the collection is then the role statement.
    // NOTE: Firestore Security Rules allow at most 10 get()/exists() calls per
    // single-document or query request. Each helper reads its profile document
    // once and reuses the data instead of re-reading it per field.
    function profileRole(collectionName, fallBackRole) {
      let profilePath = /databases/$(database)/documents/$(collectionName)/$(request.auth.uid);
      let profileData = exists(profilePath) ? get(profilePath).data : null;
      let resolvedRole = profileData != null ? canonicalRole(roleField(profileData)) : '';
      return resolvedRole != ''
        ? resolvedRole
        : profileData != null ? fallBackRole : null;
    }

    // The legacy cascade probes one collection per helper. The fallback call
    // sits inside the ternary so evaluation short-circuits as soon as a
    // collection yields a role; binding all six lookups in `let`s would probe
    // every collection on every request and could blow the 10-call budget.
    function legacyProfileRole() {
      return !isSignedIn() ? null : legacyRoleFromSuperadmins();
    }

    function legacyRoleFromSuperadmins() {
      let resolved = profileRole('superadmins', 'superadmin');
      return resolved != null ? resolved : legacyRoleFromAdmins();
    }

    function legacyRoleFromAdmins() {
      let resolved = profileRole('admins', 'admin');
      return resolved != null ? resolved : legacyRoleFromFaculty();
    }

    function legacyRoleFromFaculty() {
      let resolved = profileRole('faculty', 'faculty');
      return resolved != null ? resolved : legacyRoleFromHods();
    }

    function legacyRoleFromHods() {
      let resolved = profileRole('hods', 'hod');
      return resolved != null ? resolved : legacyRoleFromMentors();
    }

    function legacyRoleFromMentors() {
      let resolved = profileRole('mentors', 'mentor');
      return resolved != null ? resolved : legacyRoleFromStudents();
    }

    function legacyRoleFromStudents() {
      return profileRole('students', 'student');
    }

    // Resolve role without touching the user document more than once.
    function roleFromLookupOrProfile() {
      let lookupData = userDoc();
      let lookupRole = lookupData != null ? canonicalRole(roleField(lookupData)) : '';
      return lookupRole != '' ? lookupRole : legacyProfileRole();
    }

    function role() {
      let claimedRole = canonicalRole(cleanRoleValue(claimRole()));
      return claimedRole != '' ? claimedRole : roleFromLookupOrProfile();
    }

    // Legacy profile documents name the tenant collegeId, collegeID, or college.
    function profileCollegeId(collectionName) {
      let profilePath = /databases/$(database)/documents/$(collectionName)/$(request.auth.uid);
      let profileData = exists(profilePath) ? get(profilePath).data : null;
      return profileData == null ? null
        : profileData.get('collegeId', profileData.get('collegeID', profileData.get('college', null)));
    }

    // Same one-collection-per-step cascade as the legacy role resolver,
    // probing in the client's lookup order (faculty first).
    function linkedProfileCollegeId() {
      return !isSignedIn() ? null : linkedCollegeFromFaculty();
    }

    function linkedCollegeFromFaculty() {
      let resolved = profileCollegeId('faculty');
      return resolved != null ? resolved : linkedCollegeFromStudents();
    }

    function linkedCollegeFromStudents() {
      let resolved = profileCollegeId('students');
      return resolved != null ? resolved : linkedCollegeFromAdmins();
    }

    function linkedCollegeFromAdmins() {
      let resolved = profileCollegeId('admins');
      return resolved != null ? resolved : linkedCollegeFromHods();
    }

    function linkedCollegeFromHods() {
      let resolved = profileCollegeId('hods');
      return resolved != null ? resolved : linkedCollegeFromMentors();
    }

    function linkedCollegeFromMentors() {
      return profileCollegeId('mentors');
    }

    function collegeIdFromLookupOrProfile() {
      let lookupData = userDoc();
      let lookupCollege = lookupData != null ? lookupData.get('collegeId', null) : null;
      return lookupCollege != null ? lookupCollege : linkedProfileCollegeId();
    }

    function collegeId() {
      let claimedCollege = claimCollege();
      return claimedCollege != null ? claimedCollege : collegeIdFromLookupOrProfile();
    }

    function isSuperadmin() {
      return isSignedIn() && role() == 'superadmin';
    }

    // The staff list includes superadmin, so isStaff() subsumes isSuperadmin()
    // and allow conditions collapse `isSuperadmin() || isStaff()` to isStaff().
    function isStaff() {
      return isSignedIn() && role() in ['superadmin', 'admin', 'principal', 'hod', 'faculty', 'mentor'];
    }

    function isCollegeStaff() {
      let resolvedRole = role();
      return isSignedIn()
        && resolvedRole in ['superadmin', 'admin', 'principal', 'hod', 'faculty', 'mentor']
        && (resolvedRole == 'superadmin' || collegeId() != null);
    }

    function sameCollege(data) {
      return isSuperadmin()
        || (collegeId() != null && 'collegeId' in data && data.collegeId == collegeId());
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsStudentProfile(studentId, studentData) {
      return isSignedIn()
        && (
          ('userId' in studentData && studentData.userId == request.auth.uid)
          || ('uid' in studentData && studentData.uid == request.auth.uid)
          || studentId == request.auth.uid
        );
    }

    // Tenant of a student profile document, used where the accessed document
    // itself carries no collegeId (for example fees/{studentId}). Reads the
    // student document once.
    function studentCollegeId(studentId) {
      let studentData = isSignedIn() && studentId != null
        && exists(/databases/$(database)/documents/students/$(studentId))
        ? get(/databases/$(database)/documents/students/$(studentId)).data
        : null;
      return studentData != null ? studentData.get('collegeId', null) : null;
    }

    // True when the signed-in user is the addressee of a notification.
    function isRecipient(data) {
      return isSignedIn() && data != null
        && (('userId' in data && data.userId == request.auth.uid)
          || ('studentId' in data
            && (data.studentId == request.auth.uid || ownsStudentId(data.studentId))));
    }

    // assessmentQuestions inherit their tenancy from the parent test document.
    // Reads the test document once.
    function scheduledTestCollegeId(testId) {
      let testData = isSignedIn() && testId != null
        && exists(/databases/$(database)/documents/scheduledTests/$(testId))
        ? get(/databases/$(database)/documents/scheduledTests/$(testId)).data
        : null;
      return testData != null ? testData.get('collegeId', null) : null;
    }

    function ownsStudentId(studentId) {
      return isSignedIn()
        && studentId != null
        && (studentId == request.auth.uid || studentDocBelongsToUid(studentId));
    }

    // Reads the student document once (the previous version could re-read it
    // four times), so a recipient check cannot exhaust the 10-call budget.
    function studentDocBelongsToUid(studentId) {
      let studentPath = /databases/$(database)/documents/students/$(studentId);
      let studentData = exists(studentPath) ? get(studentPath).data : null;
      return studentData != null
        && (studentData.get('userId', '') == request.auth.uid
          || studentData.get('uid', '') == request.auth.uid);
    }

    function immutableUserFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.collegeId == resource.data.collegeId;
    }

    function noPasswordField() {
      return !('password' in request.resource.data);
    }

    // USERS
    match /users/{userId} {
      // Superadmin is covered by the staff branch: isStaff() is true for
      // superadmins and sameCollege() always is.
      allow read: if isOwner(userId)
        || (isStaff() && sameCollege(resource.data));
      allow create: if isSuperadmin()
        && userId == request.resource.data.uid
        && request.resource.data.role in
          ['superadmin', 'admin', 'principal', 'hod', 'mentor', 'faculty', 'student', 'parent']
        && noPasswordField();
      allow update: if isOwner(userId)
        && immutableUserFields()
        && noPasswordField()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'collegeId', 'uid', 'permissions', 'createdBy']);
      allow delete: if isSuperadmin();
    }

    match /students/{id} {
      allow get: if ownsStudentProfile(id, resource.data)
        || (isSignedIn() && 'email' in request.auth.token
          && resource.data.email == request.auth.token.email)
        || (isStaff() && sameCollege(resource.data));
      allow list: if isSignedIn() && isStaff();
      allow create: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(request.resource.data);
      allow update: if isSuperadmin()
        || (role() in ['admin', 'hod']
          && sameCollege(resource.data)
          && request.resource.data.collegeId == resource.data.collegeId
          && request.resource.data.userId == resource.data.userId);
      allow delete: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(resource.data);
    }

    match /faculty/{id} {
      allow get: if isSignedIn() && (isOwner(id)
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow list: if isSignedIn() && isStaff();
      allow write: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(request.resource.data);
    }

    match /admins/{id} {
      allow read: if isSignedIn() && (isOwner(id)
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow write: if isSuperadmin();
    }

    match /hods/{id} {
      allow read: if isSignedIn() && (isOwner(id)
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow write: if role() in ['superadmin', 'admin']
        && sameCollege(request.resource.data);
    }

    match /mentors/{id} {
      allow read: if isSignedIn() && (isOwner(id)
        || sameCollege(resource.data)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email));
      allow write: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(request.resource.data);
    }

    match /superadmins/{id} {
      allow read: if isSuperadmin()
        || isOwner(id)
        || resource.data.uid == request.auth.uid
        || ('email' in request.auth.token && resource.data.email == request.auth.token.email);
      allow write: if isSuperadmin();
    }

    match /universities/{id} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isSuperadmin();
    }

    match /colleges/{collegeId} {
      allow read: if isSignedIn() && (isSuperadmin() || collegeId() == collegeId);
      allow write: if isSuperadmin();

      match /students/{id} {
        allow read: if ownsStudentProfile(id, resource.data)
          || isSuperadmin()
          || (isStaff() && collegeId() == collegeId);
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      // Reads inside a college path use the path as the tenant boundary. For a
      // list/query request there is no `resource`, and for legacy (no custom
      // claim) staff resolving `collegeId()` on top of `role()` can exceed the
      // 10 get()/exists() call budget. Reads therefore authorise on the role
      // plus the college path; the client queries a college path it already
      // controls. Writes keep the strict college check above.
      match /config/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /announcements/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId);
      }

      // -- Legacy dashboard collections ---------------------------------------
      // These per-college collections feed the admin, principal, and faculty
      // dashboards (see src/modules/admin/api/dashboardApi.ts,
      // src/modules/admin/api/feeApi.ts, src/modules/faculty/pages/
      // FacultyDashboard.tsx). They pre-date the collegeId hygiene work, so
      // individual documents cannot be trusted to carry a collegeId field -
      // the collection path itself is the tenant boundary.

      match /schedules/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /attendance/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /attendanceRecords/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /assessments/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /scores/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /activities/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /milestones/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /feeStructures/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /feePayments/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /faculty/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (role() in ['admin', 'hod'] && collegeId() == collegeId);
      }

      match /materials/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /events/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow write: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId);
      }

      match /notifications/{docId} {
        allow get: if isSignedIn() && isStaff();
        allow list: if isSignedIn() && isStaff();
        allow create: if isSuperadmin()
          || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId);
        // Recipients may only flip their own read flag (see
        // src/modules/student/pages/StudentNotificationsPage.tsx). Before this,
        // a student could never mark a college notification as read.
        allow update: if isSuperadmin()
          || (isCollegeStaff() && collegeId() == collegeId)
          || (isSignedIn()
            && isRecipient(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow delete: if isSuperadmin()
          || (role() in ['admin', 'hod', 'principal'] && collegeId() == collegeId);
      }
    }

    match /questions/{id} {
      allow read: if isSignedIn() && isStaff();
      allow create: if isCollegeStaff() && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollegeStaff() && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if role() in ['superadmin', 'admin']
        && sameCollege(resource.data);
    }

    match /papers/{id} {
      allow read: if isSignedIn() && isStaff();
      allow create: if isCollegeStaff()
        && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.verificationStatus == 'draft';
      allow update: if isCollegeStaff()
        && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId
        && resource.data.status == 'draft'
        && resource.data.verificationStatus in ['draft', 'modification-requested', 'rejected-by-hod']
        && (resource.data.createdBy == request.auth.uid
          || role() in ['superadmin', 'admin', 'principal', 'hod'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'collegeId', 'createdBy', 'createdByName', 'status',
          'verificationStatus', 'submittedAt', 'publishedAt',
          'reviewedBy', 'reviewedByName', 'reviewedAt', 'approvalRemarks'
        ]);
      allow delete: if resource.data.status == 'draft'
        && role() in ['superadmin', 'admin']
        && sameCollege(resource.data);
    }

    match /paperReviewAudit/{auditId} {
      allow read: if role() in ['superadmin', 'admin', 'principal', 'hod']
        && sameCollege(resource.data);
      allow create, update, delete: if false;
    }

    match /attendance/{id} {
      allow get: if ownsStudentId(resource.data.studentId)
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isStaff() && sameCollege(resource.data));
      allow list: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    match /attendanceRecords/{id} {
      allow get: if ownsStudentId(resource.data.studentId)
        || (isStaff() && sameCollege(resource.data));
      allow list: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    match /payments/{id} {
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid
          || (role() in ['superadmin', 'admin', 'hod'] && sameCollege(resource.data)));
      allow write: if role() in ['superadmin', 'admin']
        && sameCollege(request.resource.data);
    }

    // Top-level feeStructures holds one document per student (queried by
    // studentId in src/modules/student/api/studentDataApi.ts), so a student
    // reads only their own record; staff read within their own college.
    match /feeStructures/{id} {
      allow read: if isSignedIn()
        && ((isStaff() && sameCollege(resource.data))
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(request.resource.data);
    }

    match /weeklySchedules/{scheduleId} {
      // `allow get` may use resource.data (single document). `allow list` is
      // role based because a list/query request has no `resource`; the client
      // keeps its queries scoped by collegeId/facultyId.
      allow get: if isSignedIn() && (isStaff() || sameCollege(resource.data));
      allow list: if isSignedIn() && isStaff();
      allow create: if isCollegeStaff() && request.resource.data.collegeId == collegeId()
        && request.resource.data.facultyId != null
        && request.resource.data.branch != null
        && request.resource.data.batch != null
        && request.resource.data.dayOfWeek != null
        && request.resource.data.startTime != null
        && request.resource.data.endTime != null;
      allow update: if isCollegeStaff() && sameCollege(resource.data);
      allow delete: if isCollegeStaff() && sameCollege(resource.data);
    }

    match /classSessions/{sessionId} {
      allow get: if isSignedIn() && (isStaff() || sameCollege(resource.data));
      allow list: if isSignedIn() && isStaff();
      allow create, update: if isCollegeStaff() && sameCollege(request.resource.data);
      allow delete: if isCollegeStaff() && sameCollege(resource.data);
    }

    match /curriculumFacultyMappings/{mappingId} {
      allow get: if isSignedIn() && (isStaff() || sameCollege(resource.data));
      allow list: if isSignedIn() && isStaff();
      allow create, update, delete: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && isStaff();
      allow create: if isCollegeStaff() && sameCollege(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollegeStaff() && sameCollege(resource.data)
        && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if role() in ['superadmin', 'admin']
        && sameCollege(resource.data);
    }

    match /scheduledTests/{testId} {
      allow read: if isStaff() && sameCollege(resource.data);
      allow write: if false;

      // The question rows carry no collegeId of their own; the parent test does.
      match /assessmentQuestions/{questionId} {
        allow read: if isSignedIn()
          && (isSuperadmin()
            || (isStaff() && scheduledTestCollegeId(testId) == collegeId()));
        allow write: if false;
      }
    }

    match /studentAssessments/{attemptId} {
      allow read: if isSignedIn()
        && ((isStaff() && sameCollege(resource.data))
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if false;
    }

    match /studentSubmissions/{submissionId} {
      allow read: if isSignedIn()
        && ((isStaff() && sameCollege(resource.data))
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if false;
    }

    match /proctoringLogs/{logId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && isStaff();
      allow create, update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (
        (isStaff() && sameCollege(resource.data))
        || ('studentUid' in resource.data && resource.data.studentUid == request.auth.uid)
        || ('studentId' in resource.data && ownsStudentId(resource.data.studentId))
      );
      allow list: if isSignedIn() && isStaff();
      allow create: if false;
      allow update, delete: if false;
    }

    match /assignmentSubmissionDrafts/{draftId} {
      allow read, write: if false;
    }

    match /gradeRecords/{gradeId} {
      allow read: if (
          ownsStudentId(resource.data.studentId)
          && resource.data.status == 'published'
        )
        || (role() in ['superadmin', 'admin', 'principal', 'hod']
          && sameCollege(resource.data));
      allow create, update, delete: if false;
    }

    match /gradeRecordAudit/{auditId} {
      allow read: if role() in ['superadmin', 'admin', 'principal', 'hod']
        && sameCollege(resource.data);
      allow create, update, delete: if false;
    }

    // Audit trail. No client writes logs - Cloud Functions do (Admin SDK
    // bypasses rules), so client creates are closed to keep the trail
    // unfalsifiable.
    match /logs/{id} {
      allow read: if role() in ['superadmin', 'admin']
        && sameCollege(resource.data);
      allow create: if false;
      allow update, delete: if isSuperadmin();
    }

    match /ai_generation_logs/{id} {
      allow read: if isSignedIn() && (isSuperadmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && (
        isStaff()
        || resource.data.userId == request.auth.uid
        || ownsStudentId(resource.data.studentId)
      );
      // Recipients may only flip their own read flag (see markNotificationRead
      // in src/modules/student/api/studentDataApi.ts). Everything else is
      // college staff, scoped to their own tenant.
      allow create: if isCollegeStaff() && sameCollege(request.resource.data);
      allow update: if (isCollegeStaff() && sameCollege(resource.data))
        || (isSignedIn()
          && isRecipient(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isCollegeStaff() && sameCollege(resource.data);
    }

    // -- Curriculum, topics, and test papers ----------------------------------
    // Read by the curriculum, topics, and dashboard flows in
    // src/modules/superadmin/api/curriculumApi.ts and
    // src/modules/faculty/api/facultyApi.ts. Writes stay with superadmin and
    // college administration; faculty may only read.

    match /curriculum/{docId} {
      allow get: if isSignedIn()
        && isStaff()
        && (sameCollege(resource.data) || !('collegeId' in resource.data));
      allow list: if isSignedIn() && isStaff();
      allow write: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(request.resource.data);
    }

    match /syllabusExtracts/{docId} {
      allow get: if isSignedIn()
        && isStaff()
        && (sameCollege(resource.data) || !('collegeId' in resource.data));
      allow list: if isSignedIn() && isStaff();
      allow write: if role() in ['superadmin', 'admin', 'hod']
        && sameCollege(request.resource.data);
    }

    match /topics/{docId} {
      allow get: if isSignedIn()
        && (isStaff()
          || ('facultyId' in resource.data && resource.data.facultyId == request.auth.uid));
      allow list: if isSignedIn() && isStaff();
      allow write: if isSuperadmin();
    }

    match /testPapers/{docId} {
      allow get: if isSignedIn()
        && (isStaff()
          || ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid));
      allow list: if isSignedIn() && isStaff();
      allow write: if isSuperadmin();
    }

    // -- Attendance summaries --------------------------------------------------
    // Written inside the same atomic batch as attendance and attendanceRecords
    // (src/modules/faculty/api/facultyApi.ts markAttendance). A missing rule
    // here failed the entire batch, so attendance could never be saved.
    match /attendanceSummary/{docId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff() && sameCollege(request.resource.data);
    }

    // -- Fees and library ------------------------------------------------------
    // fees is keyed by student id, so the tenant is resolved from the student
    // profile rather than from a field on the fee document itself.
    match /fees/{studentId} {
      allow read: if isSignedIn()
        && (isStaff() || isOwner(studentId) || ownsStudentId(studentId));
      allow write: if isSuperadmin()
        || (role() in ['admin', 'hod'] && studentCollegeId(studentId) == collegeId());
    }

    match /libraryBooks/{docId} {
      allow read: if isSignedIn();
      allow write: if role() in ['superadmin', 'admin', 'hod'];
    }

    match /issuedBooks/{docId} {
      allow read: if isSignedIn()
        && (isStaff()
          || ('studentId' in resource.data
            && (resource.data.studentId == request.auth.uid
              || ownsStudentId(resource.data.studentId))));
      allow write: if isCollegeStaff();
    }

    // -- Shared cloud question bank --------------------------------------------
    // Backs src/modules/admin/api/cloudStorageApi.ts. These collections are
    // shared across colleges by design ("papers_universal"), so access is
    // role-based rather than tenant-scoped, matching the existing questions
    // and papers rules.
    match /questionBank_meta/{docId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff();
    }

    match /papers_universal/{docId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff();
    }

    match /paperTemplates/{docId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff();
    }

    match /questionReviews/{docId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if isCollegeStaff();
    }

    // Written by Cloud Functions only; the admin UI reads it through
    // src/modules/admin/api/assessmentsApi.ts.
    match /reviewQueue/{docId} {
      allow read: if isSignedIn() && isStaff();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
